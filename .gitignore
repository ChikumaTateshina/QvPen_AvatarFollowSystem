# =====================================================================
#  QvPen Avatar Follow System  /  .gitignore
# ---------------------------------------------------------------------
#  このリポジトリのルートは Unity プロジェクト全体ではなく，
#  Assets/Releases/QvPen_AvatarFollowSystem/ に相当するパッケージフォルダです．
#
#  【重要】 *.meta は絶対に除外しないこと．
#  Unity は .meta の GUID で参照を解決するため，除外すると Prefab や
#  UdonSharpProgramAsset の参照が切れます．
# =====================================================================


# ---------------------------------------------------------------------
#  配布用アーティファクト
#  ビルド成果物はリポジトリに含めず，GitHub Release に添付する運用とする
# ---------------------------------------------------------------------
*.unitypackage
*.unitypackage.meta
*.zip
*.zip.meta

# build_vpm_listing.py の出力先
/dist/
/site/


# ---------------------------------------------------------------------
#  UdonSharp / VRChat SDK の自動生成物
#  コンパイル時に再生成されるためコミット不要
# ---------------------------------------------------------------------
SerializedUdonPrograms/
*.asmdef.bak


# ---------------------------------------------------------------------
#  Unity 生成物
#  (将来リポジトリのルートをプロジェクト直下へ移した場合の保険)
# ---------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
sysinfo.txt
crashlytics-build.properties


# ---------------------------------------------------------------------
#  IDE / エディタ
# ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.unityproj
*.pidb
*.booproj
*.svd


# ---------------------------------------------------------------------
#  一時ファイル / バックアップ
# ---------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
*~
# Web ページ(Unity に無視させるため末尾が ~)は上の *~ から除外する
!/Website~/


# ---------------------------------------------------------------------
#  OS 生成物
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
